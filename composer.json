{
    "name": "ezappslab/example",
    "description": "Laravel package boilerplate",
    "type": "library",
    "version": "1.0.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Radoslav Boydev"
        }
    ],
    "autoload": {
        "psr-4": {
            "Infinity\\Example\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/",
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.3",
        "spatie/laravel-package-tools": "^1.93"
    },
    "require-dev": {
        "orchestra/testbench": "^10.9 || ^11.0",
        "larastan/larastan": "^3.8",
        "laravel/pint": "^1.25",
        "mockery/mockery": "^1.6.12",
        "pestphp/pest": "^4.4 || ^5.0",
        "pestphp/pest-plugin": "^4.0 || ^5.0",
        "pestphp/pest-plugin-arch": "^4.0 || ^5.0",
        "pestphp/pest-plugin-faker": "^4.0 || ^5.0",
        "pestphp/pest-plugin-mutate": "^4.0 || ^5.0",
        "pestphp/pest-plugin-laravel": "^4.1 || ^5.0"
    },
    "suggest": {
        "pestphp/pest-plugin-phpstan": "Provides PHPStan integration when developing with Pest 5.",
        "pestphp/pest-plugin-rector": "Provides Rector integration when developing with Pest 5.",
        "pestphp/pest-plugin-type-coverage": "Provides type coverage reporting when developing with Pest 5.",
        "rector/rector": "Provides automated refactoring when developing with Pest 5."
    },
    "extra": {
        "laravel": {
            "providers": [
                "Infinity\\Example\\ExampleServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "@php vendor/bin/pint --ansi",
            "@php vendor/bin/phpstan analyse --verbose --ansi"
        ],
        "test": "@php vendor/bin/pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
